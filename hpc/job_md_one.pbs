#!/bin/bash
#PBS -N am26_md_one
#PBS -q <<GPU_QUEUE>>
#PBS -l select=1:ncpus=<<NCPUS>>:ngpus=1:mem=<<MEM_GB>>gb
#PBS -l walltime=<<HH:MM:SS>>
#PBS -j oe
# 20 ps Langevin NVT at 300 K and 1500 K on the first held-out silica cell with ONE model, in float32.
# NAME = checkpoint stem under modules/M1_finetune_asio2/checkpoints, or "zero-shot".
#   qsub -v NAME=am26_asio2_mpa0_naive job_md_one.local.pbs
# Output: modules/M1_finetune_asio2/outputs/md_stability_<NAME>/
# Copy to job_md_one.local.pbs, replace every <<...>>, then submit the copy.

set -euo pipefail
: "${NAME:?set NAME}"
REPO="<<REPO>>"
<<ENV_SETUP>>
conda activate examples-mlip

cd "$REPO"
echo "host $(hostname)  start $(date -u +%FT%TZ)  model $NAME"
nvidia-smi || true
if [ "$NAME" = "zero-shot" ]; then
  SPEC="zero-shot=models_cache/mace-mpa-0-medium.model"
else
  test -f "modules/M1_finetune_asio2/checkpoints/$NAME.model" || { echo "checkpoint $NAME missing" >&2; exit 2; }
  SPEC="$NAME=modules/M1_finetune_asio2/checkpoints/$NAME.model"
fi

python modules/M1_finetune_asio2/md_stability.py \
    --device cuda --dtype float32 --test data/splits/a-SiO2/test.xyz --frame 0 --temps 300 1500 --ps 20 \
    --out "modules/M1_finetune_asio2/outputs/md_stability_$NAME" \
    --model "$SPEC"

echo "end $(date -u +%FT%TZ)"
